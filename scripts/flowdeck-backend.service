# Copy to /etc/systemd/system/flowdeck-backend.service after replacing User,
# WorkingDirectory, PYTHONPATH and ExecStart with this deployment's paths.
# ExecStart must use the environment's actual Python (venv or conda).
[Unit]
Description=Flowdeck Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=george
WorkingDirectory=/home/george/repositories/flowdeck/backend
Environment=PYTHONPATH=/home/george/repositories/flowdeck
Environment=FLOWDECK_ANALYSIS_WORKERS=5
Environment=FLOWDECK_ANALYSIS_QUEUE_SIZE=unlimited
ExecStart=/home/george/repositories/flowdeck/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8002 --workers 1 --log-config /home/george/repositories/flowdeck/backend/uvicorn_logging.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
