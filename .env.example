# Flowdeck Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: LLM API Keys
# ============================================
# OpenAI API Key (required for AI analysis)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alpha Vantage API Key (required for market data)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# ============================================
# OPTIONAL: Additional LLM Providers
# ============================================
# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Google Gemini API Key
GOOGLE_API_KEY=

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# ============================================
# DATABASE
# ============================================
# SQLite database path (default: sqlite:///./data/flowdeck.db)
DATABASE_URL=sqlite:///./data/flowdeck.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/flowdeck

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# Google OAuth (optional, for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3003/auth/callback

# ============================================
# PAYMENT INTEGRATION (Optional)
# ============================================
# PayPal Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # Use 'live' for production

# ============================================
# EMAIL SERVICE (Optional)
# ============================================
# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com

# ============================================
# APPLICATION SETTINGS
# ============================================
# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3003,http://localhost:80

# Enable daily sync of major stocks (true/false)
ENABLE_DAILY_SYNC=false

# Sync schedule time (24-hour format, e.g., 06:00)
SYNC_SCHEDULE_TIME=06:00

# Enable market overview cache refresh (true/false)
ENABLE_MARKET_OVERVIEW_CACHE_REFRESH=true

# Enable digest scheduler for email notifications (true/false)
ENABLE_DIGEST_SCHEDULER=false

# Digest scheduler interval in minutes
DIGEST_SCHEDULER_INTERVAL_MINUTES=15

# ============================================
# REDIS (Optional, for caching)
# ============================================
# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# ============================================
# ADDITIONAL DATA SOURCES (Optional)
# ============================================
# Finnhub API Key (for additional market data)
FINNHUB_API_KEY=

# News API Key (for news aggregation)
NEWS_API_KEY=

# Reddit API (for sentiment analysis)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Flowdeck/1.0

# ============================================
# LOGGING & MONITORING
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable debug mode (true/false)
DEBUG=false

# ============================================
# DOCKER/KUBERNETES SPECIFIC
# ============================================
# For containerized deployments, these are typically set in
# docker/compose.yml or Kubernetes ConfigMaps/Secrets

# Backend service URL (for frontend in production)
VITE_API_URL=https://api.yourdomain.com

# WebSocket URL (for real-time features)
VITE_WS_URL=wss://api.yourdomain.com

# ============================================
# IBM CLOUD SPECIFIC (for deployment)
# ============================================
# IBM Cloud region
IBM_CLOUD_REGION=us-south

# IBM Cloud resource group
IBM_CLOUD_RESOURCE_GROUP=default

# Kubernetes cluster name
CLUSTER_NAME=flowdeck-cluster

# Container registry namespace
REGISTRY_NAMESPACE=flowdeck

# Image tag for deployments
IMAGE_TAG=latest
