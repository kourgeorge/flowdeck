# -----------------------------------------------------------------------------
# Root Environment - used by systemd (EnvironmentFile) and analysis service
# -----------------------------------------------------------------------------
# cp .env.example .env
# -----------------------------------------------------------------------------
# When deploying with systemd, this file provides API keys to the backend.
# For local dev, you can use backend/.env instead (see backend/.env.example).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# API Keys (required for analysis and market data)
# -----------------------------------------------------------------------------

# OpenAI (when not using Azure)
OPENAI_API_KEY=sk-...

# Azure OpenAI (preferred when set)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=...
OPENAI_API_VERSION=2024-08-01-preview

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=...

# Reddit (optional)
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# REDDIT_USER_AGENT=TradingAgents/1.0
