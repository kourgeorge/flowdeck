# Flowdeck Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED: LLM API Keys
# ============================================
# OpenAI API Key (required for AI analysis)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alpha Vantage API Key (required for market data)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# ============================================
# OPTIONAL: Additional LLM Providers
# ============================================
# Anthropic Claude API Key
ANTHROPIC_API_KEY=

# Google Gemini API Key
GOOGLE_API_KEY=

# Azure OpenAI Configuration
# Set LLM_PROVIDER=azure to use it. Models are picked by DEEP_THINK_MODEL / QUICK_THINK_MODEL.
# LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# DEEP_THINK_MODEL=gpt-4o
# QUICK_THINK_MODEL=gpt-4o-mini

# ============================================
# DATABASE
# ============================================
# SQLite database path (default: sqlite:///./data/flowdeck.db)

# ============================================
# OPTIONAL: LiteLLM Proxy
# ============================================
# LiteLLM Proxy Configuration
# Allows routing requests through LiteLLM proxy for unified LLM access
# 
# To use LiteLLM proxy, configure as follows:
# 1. Set LLM_PROVIDER to "openai" (LiteLLM is OpenAI-compatible)
# 2. Set OPENAI_API_KEY to your LiteLLM proxy key
# 3. Set BACKEND_URL to the LiteLLM proxy endpoint
# 4. Specify models with provider prefix (e.g., azure/model-name, openai/gpt-4o)
#
# Example LiteLLM Configuration:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-litellm-proxy-api-key-here
# LLM_BACKEND_URL=https://litellm.kour.me
# DEEP_THINK_MODEL=azure/o3-mini-2025-01-31
# QUICK_THINK_MODEL=azure/gpt-4o-mini-2024-07-18
#
# Supported model prefixes in LiteLLM:
# - openai/gpt-4o, openai/gpt-4o-mini
# - anthropic/claude-3-5-sonnet-20241022
# - google/gemini-pro
# - azure/o3-mini-2025-01-31, azure/gpt-4o-mini-2024-07-18

DATABASE_URL=sqlite:///./data/flowdeck.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/flowdeck

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Required for auth: set a random secret of at least 32 characters before startup.
# Generate once with: openssl rand -hex 32
# Keep this value across restarts. Changing it invalidates existing login tokens.
JWT_SECRET=

# Google OAuth (optional, for social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3003/auth/callback

# ============================================
# PAYMENT INTEGRATION (Optional)
# ============================================
# PayPal Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox  # Use 'live' for production

# ============================================
# EMAIL SERVICE (Optional)
# ============================================
# Emails are sent through AgentMail. Without AGENTMAIL_API_KEY, emails are silently skipped.
# Get API key from https://console.agentmail.to (Dashboard -> API Keys)
AGENTMAIL_API_KEY=

# Inbox: your sending identity (Dashboard -> Inboxes). Also used as SMTP username if AGENTMAIL_SMTP_USER not set.
AGENTMAIL_INBOX_ID=

# SMTP (recommended). Per AgentMail docs: Host=smtp.agentmail.to, Port=465, SSL required.
# Username = your inbox email address. Password = your API key (or set AGENTMAIL_SMTP_PASSWORD).
# AGENTMAIL_SMTP_USER=your-inbox@agentmail.to
# AGENTMAIL_SMTP_HOST=smtp.agentmail.to
# AGENTMAIL_SMTP_PORT=465

# SMTP password override for AgentMail (if different from API key)
# AGENTMAIL_SMTP_PASSWORD=

# ============================================
# APPLICATION SETTINGS
# ============================================
# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3003,http://localhost:80

# Enable daily sync of major stocks (true/false)
ENABLE_DAILY_SYNC=false

# Sync schedule time (24-hour format, e.g., 06:00)
SYNC_SCHEDULE_TIME=06:00

# Enable market overview cache refresh (true/false)
ENABLE_MARKET_OVERVIEW_CACHE_REFRESH=true

# Enable event-driven re-analysis of subscribed tickers on an event-signal spike
# (true/false, weekdays only)
ENABLE_EVENT_MONITOR=true

# Hour (0-23) to run the event monitor; keep it after SYNC_SCHEDULE_TIME
EVENT_MONITOR_HOUR=7

# Enable digest scheduler for email notifications (true/false)
ENABLE_DIGEST_SCHEDULER=false

# Digest scheduler interval in minutes
DIGEST_SCHEDULER_INTERVAL_MINUTES=15

# ============================================
# ADDITIONAL DATA SOURCES (Optional)
# ============================================
# FRED API Key (Federal Reserve Economic Data - for treasury rates and economic indicators)
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub API Key (for additional market data)
FINNHUB_API_KEY=

# News API Key (for news aggregation)
NEWS_API_KEY=

# Reddit API (for sentiment analysis)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Flowdeck/1.0

# ============================================
# DOCKER/KUBERNETES SPECIFIC
# ============================================
# For containerized deployments, these are typically set in
# docker/compose.yml or Kubernetes ConfigMaps/Secrets

# Backend service URL (for frontend in production)
VITE_API_URL=https://api.yourdomain.com

# WebSocket URL (for real-time features)
VITE_WS_URL=wss://api.yourdomain.com

# ============================================
# IBM CLOUD SPECIFIC (for deployment)
# ============================================
# IBM Cloud region
IBM_CLOUD_REGION=us-south

# IBM Cloud resource group
IBM_CLOUD_RESOURCE_GROUP=default

# Kubernetes cluster name
CLUSTER_NAME=flowdeck-cluster

# Container registry namespace
REGISTRY_NAMESPACE=flowdeck

# Image tag for deployments
IMAGE_TAG=latest
