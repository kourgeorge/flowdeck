{
  "name": "flowdeck-backend-node",
  "version": "1.0.0",
  "description": "Node.js alternative backend for Stock Dashboard; Python agents run as subprocess.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "yahoo-finance2": "^2.11.3",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
