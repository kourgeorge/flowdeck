# -----------------------------------------------------------------------------
# Backend Environment - copy to .env and fill in values
# -----------------------------------------------------------------------------
# cp backend/.env.example backend/.env
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# API Keys (required for full functionality)
# -----------------------------------------------------------------------------

# --- OpenAI ---
# Provider: default when Azure not configured; or set LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# DEEP_THINK_MODEL=gpt-4o
# QUICK_THINK_MODEL=gpt-4o-mini

# --- Azure OpenAI ---
# Provider: set LLM_PROVIDER=azure (or set both endpoint and key; provider inferred)
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=...
OPENAI_API_VERSION=2024-12-01-preview
# DEEP_THINK_MODEL=gpt-4o
# QUICK_THINK_MODEL=gpt-4o-mini

# --- Cerebras ---
# Provider: set LLM_PROVIDER=cerebras
# Get API key from https://cloud.cerebras.ai/
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=csk-...
# DEEP_THINK_MODEL=gpt-oss-120b
# QUICK_THINK_MODEL=llama3.1-8b
# CEREBRAS_REASONING_EFFORT=medium   (for gpt-oss-120b: low, medium, high)

# FRED API (risk-free rate + market rates for valuation; falls back to hardcoded defaults when unset)
# Get free key from https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=...

# Alpha Vantage (market data, fundamentals)
ALPHA_VANTAGE_API_KEY=...

# SerpAPI (optional; for chat "Web Search", Global News tool, and watchlist "deep research" web stage)
# Used by: chat web_search tool, get_global_news (tried first when set), and watchlist pipeline stage 4.
# When set, Global News uses SerpAPI Google News instead of scraping; pipeline stage 4 runs web research.
# SERPAPI_KEY=...

# Reddit (optional; for social/news when enabled)
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# REDDIT_USER_AGENT=TradingAgents/1.0

# -----------------------------------------------------------------------------
# Backend / Dashboard
# -----------------------------------------------------------------------------

# SQLite database (default: backend/flowdeck.db)
# DATABASE_URL=sqlite:///./flowdeck.db

# JWT secret for auth (change in production)
# JWT_SECRET=your-secure-random-secret

# Google OAuth (for "Sign in with Google")
# Get credentials from https://console.cloud.google.com/
# Create OAuth 2.0 Client ID and add authorized redirect URI
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Production: https://flowdeck.biz/api/auth/google/callback
# Development: http://localhost:8002/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://flowdeck.biz/api/auth/google/callback

# CORS: comma-separated allowed origins (required in production)
# Dev: leave empty to allow localhost:3003, 3000, 5173
# Prod: https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=

# Internal URL for analysis service and cron (same server)
# Dev: http://127.0.0.1:8002
# Prod: http://127.0.0.1:8002 (keep as loopback when backend is local)
BACKEND_URL=http://127.0.0.1:8002

# Optional: override info service URL (defaults to BACKEND_URL)
# INFO_SERVICE_URL=http://127.0.0.1:8002

# Write AI agent reports as markdown files inside the results/<TICKER>/<run_id>/reports/ folder.
# Disabled by default. Set to true to enable.
# WRITE_AI_REPORTS_TO_RESULTS=false

# Daily sync
ENABLE_DAILY_SYNC=true
SYNC_SCHEDULE_TIME=06:00

# Market overview cache refresh (runs every 5 minutes)
# Disable to reduce background network load (default: true)
ENABLE_MARKET_OVERVIEW_CACHE_REFRESH=true
# Hard timeout in seconds for each cache refresh job.
# If a job exceeds this it is killed and the slot is released (default: 240)
# MARKET_CACHE_REFRESH_TIMEOUT=240

# Event-driven re-analysis: re-runs a subscribed ticker's analysis when its event
# signal spikes versus the last run (default: true, weekdays only).
# Spend is capped by COOLDOWN_HOURS in services/event_monitor_service.py.
ENABLE_EVENT_MONITOR=true
# Hour (0-23, server local time) to run it. Keep it after SYNC_SCHEDULE_TIME so a
# ticker the daily sync just analyzed is inside its cooldown, not analyzed twice.
# EVENT_MONITOR_HOUR=7

# Daily brief scheduler (emails for user daily/weekly briefs)
# Disabled by default; set true to enable background scheduled jobs.
ENABLE_DIGEST_SCHEDULER=false
# Poll interval in minutes for due daily brief jobs.
DIGEST_SCHEDULER_INTERVAL_MINUTES=15
# Default timezone for digest scheduling (IANA tz name, e.g. America/New_York)
# DIGEST_DEFAULT_TIMEZONE=UTC

# Admin email (used for system notifications)
# ADMIN_EMAIL=admin@example.com

# SQLite: enable SQL query logging (default: false)
# SQL_ECHO=false

# Path to override the data cache directory
# DATA_CACHE_PATH=

# LLM token cost multiplier for platform token accounting (default: 1)
# LLM_TOKENS_PER_PLATFORM_TOKEN=1

# Backend port (default 8002)
PORT=8002

# -----------------------------------------------------------------------------
# Report email notifications (AgentMail) – all configurable via .env
# -----------------------------------------------------------------------------
# Get API key from https://console.agentmail.to (Dashboard → API Keys)
# AGENTMAIL_API_KEY=am_...

# Inbox: your sending identity (Dashboard → Inboxes). Required for API; also used as SMTP username if AGENTMAIL_SMTP_USER not set.
# AGENTMAIL_INBOX_ID=your-inbox@agentmail.to

# HTTP API (used when SMTP not configured or as fallback)
# AGENTMAIL_API_BASE_URL=https://api.agentmail.to/v0

# SMTP (recommended). Per AgentMail docs: Host=smtp.agentmail.to, Port=465, SSL required.
# Username = your inbox email address. Password = your API key (or set AGENTMAIL_SMTP_PASSWORD).
# AGENTMAIL_SMTP_USER=your-inbox@agentmail.to
# AGENTMAIL_SMTP_HOST=smtp.agentmail.to
# AGENTMAIL_SMTP_PORT=465

# Public frontend URL — used for all links in emails (dashboard, stock pages). Must be the app URL users open in the browser (e.g. https://flowdeck.example.com), not the backend API.
# FRONTEND_URL=http://localhost:5173

# Share links: secret key for obfuscated report URLs (viewable without login). Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, share URLs are not generated and /api/share/{token} returns 404.
# SHARE_SECRET_KEY=...

# SMTP password override for AgentMail (if different from API key)
# AGENTMAIL_SMTP_PASSWORD=...

# -----------------------------------------------------------------------------
# PayPal Payment Integration
# -----------------------------------------------------------------------------
# Get credentials from https://developer.paypal.com/
# For testing: use "sandbox" mode with sandbox credentials
# For production: use "live" mode with live credentials

# PayPal mode: sandbox or live
PAYPAL_MODE=sandbox

# PayPal API credentials (get from PayPal Developer Dashboard)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret