# -----------------------------------------------------------------------------
# Frontend Environment - copy to .env and fill in values
# -----------------------------------------------------------------------------
# cp frontend/.env.example frontend/.env
# -----------------------------------------------------------------------------
# Note: Vite only exposes vars prefixed with VITE_ to the client.
# -----------------------------------------------------------------------------

# API base URL for requests (build-time; empty = same-origin)
# Dev: leave empty so Vite proxies /api to backend
# Prod same-origin: leave empty if API is at /api on same domain
# Prod subdomain: https://api.your-domain.com
VITE_API_URL=

# Optional: WebSocket URL (defaults derived from host)
# VITE_WS_URL=

# Optional: dev proxy target (when backend is not on 127.0.0.1:8002)
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8002
# VITE_DEV_WS_TARGET=ws://127.0.0.1:8002

# Optional: app name (default: Flowdeck)
# VITE_APP_NAME=Flowdeck
